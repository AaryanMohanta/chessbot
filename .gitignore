__pycache__/
*.pyc
.pytest_cache/
dist/
*.egg-info/
.venv/
venv/

# Regenerable report artifact; games.csv and zoo/ ARE tracked on purpose
# (games.csv is the ratings source of truth, zoo/ preserves every frozen
# version) but this plot is just derived from them.
ratings/ladder.png

# Local-only calibration opponent (~150MB with source). Third-party
# engines are banned from the submission zip, not from local testing, but
# this is a downloaded binary that doesn't belong in version control
# either way — each dev fetches their own via tools/setup_stockfish.md.
tools/stockfish/

# Downloaded third-party opening book (official-stockfish/books,
# 8moves_v3.pgn, ~8MB/34.7k lines) used for calibration/SPRT variety —
# not authored here, re-fetched via ratings/calibrate_stockfish.py's
# --openings-pgn default download logic rather than checked in.
tools/books/

# Ad-hoc run logs from manual calibration/SPRT sessions — ephemeral
# diagnostic output, not infrastructure. games.csv (the real record of
# every game played) and zoo/ are tracked; these raw logs are not.
ratings/calibration_logs/

# Downloaded third-party tuning dataset (Zurichess quiet-labeled.epd,
# ~725k positions, ~40MB) plus its converted CSV, fetched by
# tools/convert_quiet_labeled.py -- design doc's own rule is "tuning data
# never ships, only the fitted numbers go in the zip as a Python file"
# (see cb_nb_pst_tuned.py), and it doesn't belong in version control for
# the same reason tools/stockfish/ and tools/books/ don't.
ratings/data/

# Auto-generated by tools/build_zip.py on every run (see
# generate_build_tag_file) -- identifies which build/config played a
# given ladder game. Regenerated fresh per build, not meant to be
# hand-edited or committed.
cb_build_tag.py

# Ladder game log/PGN pairs fed to ratings/ingest_ladder_logs.py --
# ratings/ladder_games.csv (the parsed, structured record) IS tracked,
# same reasoning as games.csv; the raw source files are not.
ratings/ladder_logs/
